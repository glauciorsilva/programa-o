rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador / TI: só vale com o e-mail VERIFICADO.
    // Isso impede que outra pessoa cadastre esse e-mail e ganhe acesso.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'rafael.glaucio2@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.totalSeconds == 0;

      // O aluno atualiza o próprio progresso/tempo, mas não troca e-mail nem data de cadastro.
      allow update: if isOwner(uid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if isAdmin();
      }
    }
  }
}
